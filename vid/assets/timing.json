    {
      "scene": "s01-guess",
      "who": "narrator",
      "start": 0.25,
      "end": 5.911,
      "text": [
        "You pay for the smartest AI there is. Ask it why you're tired this week... and it guesses."
      ]
    },
    {
      "scene": "s02-islands",
      "who": "narrator",
      "start": 6.411,
      "end": 13.244,
      "text": [
        "The answer's in your apps. Your cycle in Flo. Your nutrients in Cronometer. Your training in Strong. Your AI can't open any of them."
      ]
    },
    {
      "scene": "s03-reveal",
      "who": "narrator",
      "start": 14.944,
      "end": 15.984,
      "text": [
        "Yuzu."
      ]
    },
    {
      "scene": "s03-reveal",
      "who": "narrator",
      "start": 15.744,
      "end": 18.267,
      "text": [
        "It connects them. Even the ones with no API."
      ]
    },
    {
      "scene": "s04-connect",
      "who": "narrator",
      "start": 19.284,
      "end": 24.884,
      "text": [
        "Sign in once. Yuzu reads your account, writes the tools, and tests a real request."
      ]
    },
    {
      "scene": "s05-link",
      "who": "narrator",
      "start": 27.184,
      "end": 30.31,
      "text": [
        "Then ONE link goes into every assistant you use."
      ]
    },
    {
      "scene": "s06-knows",
      "who": "narrator",
      "start": 38.084,
      "end": 40.476,
      "text": [
