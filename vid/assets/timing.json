    {
      "scene": "s01-guess",
      "who": "narrator",
      "start": 0.25,
      "end": 5.911,
      "text": [
        "You pay for the smartest AI there is. Ask it why you're tired this week... and it guesses."
      ]
    },
    {
      "scene": "s02-islands",
      "who": "narrator",
      "start": 6.411,
      "end": 13.244,
      "text": [
        "The answer's in your apps. Your cycle in Flo. Your nutrients in Cronometer. Your training in Strong. Your AI can't open any of them."
      ]
    },
    {
      "scene": "s03-reveal",
      "who": "narrator",
      "start": 15.044,
      "end": 18.379,
      "text": [
        "ycyc connects them. Even the ones with no API."
      ]
    },
    {
      "scene": "s04-connect",
      "who": "narrator",
      "start": 19.279,
      "end": 25.244,
      "text": [
        "Sign in once. ycyc reads your account, writes the tools, and tests a real request."
      ]
    },
    {
      "scene": "s05-link",
      "who": "narrator",
      "start": 27.179,
      "end": 30.304,
      "text": [
        "Then ONE link goes into every assistant you use."
      ]
    },
    {
      "scene": "s06-knows",
      "who": "narrator",
      "start": 38.079,
      "end": 40.471,
      "text": [
        "Same question. Now it actually knows you."
      ]
    },
    {
      "scene": "s07-approve",
      "who": "narrator",
      "start": 41.779,
      "end": 43.939,
      "text": [
